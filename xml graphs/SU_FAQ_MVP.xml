              <eventType />
              <eventScope>private</eventScope>
              <eventTypeData />
              <eventDescription>&lt;p&gt;Your records should describe your diagnosis, if made; illness and treatment history; current symptoms and everyday functioning; and current or planned treatment. Include information about how the impairment affects your ability to work, where available. Submit the relevant information already contained in your records.&lt;/p&gt;</eventDescription>
              <purpose>Sources: SU-Handicap-report.md, documentation requirements and pitfalls; www.su.dk_handicaptillaeg_om-dokumentation.md; www.su.dk_handicaptillaeg_spoergsmaal-og-svar-om-handicaptillaeg.md. Guideline-based answer enriched with FAQ information.</purpose>
              <guide />
              <insight use="false" />
              <level>100</level>
