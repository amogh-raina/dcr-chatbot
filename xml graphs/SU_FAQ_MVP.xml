              <eventType />
              <eventScope>private</eventScope>
              <eventTypeData />
              <eventDescription>&lt;p&gt;Include existing medical records describing each impairment you want assessed. Relevant records may come from a hospital, outpatient clinic, specialist or your GP. The minimum requirement is intended to use existing records you can access free of charge; you are not expected to buy a new medical statement just to apply.&lt;/p&gt;</eventDescription>
              <purpose>Sources: SU-Handicap-report.md, documentation requirements and pitfalls; www.su.dk_handicaptillaeg_om-dokumentation.md; www.su.dk_handicaptillaeg_spoergsmaal-og-svar-om-handicaptillaeg.md. Guideline-based answer enriched with FAQ information.</purpose>
              <guide />
              <insight use="false" />
              <level>100</level>
              <sequence>6</sequence>
              <costs>0</costs>
              <eventData>
                <styles />
                <dataType format="int" sequence="0" width="large">label</dataType>
              </eventData>
              <interfaces />
            </custom>
          </event>
          <event id="FAQ_Answer_2">
            <precondition message="" />
            <custom>
              <visualization>
                <location xLoc="150" yLoc="730" />
                <colors bg="#f9f7ed" textStroke="#000000" stroke="#cccccc" />
              </visualization>
              <roles>
                <role description="" specification="">Chatbot</role>
              </roles>
              <readRoles />
              <groups>
                <group />
              </groups>
              <phases>
                <phase />
              </phases>
              <eventType />
              <eventScope>private</eventScope>
              <eventTypeData />
              <eventDescription>&lt;p&gt;Public hospital records are usually available through sundhed.dk. Ask your GP, private hospital or specialist for access to relevant records they hold. Include records concerning each impairment you list, rather than unrelated parts of your medical history.&lt;/p&gt;</eventDescription>
              <purpose>Sources: SU-Handicap-report.md, documentation requirements and pitfalls; www.su.dk_handicaptillaeg_om-dokumentation.md; www.su.dk_handicaptillaeg_spoergsmaal-og-svar-om-handicaptillaeg.md. Guideline-based answer enriched with FAQ information.</purpose>
              <guide />
              <insight use="false" />
              <level>100</level>
              <sequence>7</sequence>
              <costs>0</costs>
              <eventData>
                <styles />
                <dataType format="int" sequence="0" width="large">label</dataType>
              </eventData>
              <interfaces />
            </custom>
          </event>
          <event id="FAQ_Answer_3">
            <precondition message="" />
            <custom>
              <visualization>
                <location xLoc="150" yLoc="900" />
                <colors bg="#f9f7ed" textStroke="#000000" stroke="#cccccc" />
              </visualization>
              <roles>
                <role description="" specification="">Chatbot</role>
              </roles>
              <readRoles />
              <groups>
                <group />
              </groups>
              <phases>
                <phase />
              </phases>
              <eventType />
              <eventScope>private</eventScope>
              <eventTypeData />
              <eventDescription>&lt;p&gt;Yes. Include relevant records even if they are more than three years old. Add newer records if you have them, especially if your symptoms, treatment or everyday functioning have changed. Older records can still help explain your medical history.&lt;/p&gt;</eventDescription>
              <purpose>Sources: SU-Handicap-report.md, documentation requirements and pitfalls; www.su.dk_handicaptillaeg_om-dokumentation.md; www.su.dk_handicaptillaeg_spoergsmaal-og-svar-om-handicaptillaeg.md. Guideline-based answer enriched with FAQ information.</purpose>
              <guide />
              <insight use="false" />
              <level>100</level>
              <sequence>8</sequence>
              <costs>0</costs>
              <eventData>
                <styles />
                <dataType format="int" sequence="0" width="large">label</dataType>
              </eventData>
              <interfaces />
            </custom>
          </event>
          <event id="FAQ_Answer_4">
            <precondition message="" />
            <custom>
              <visualization>
                <location xLoc="150" yLoc="1070" />
                <colors bg="#f9f7ed" textStroke="#000000" stroke="#cccccc" />
              </visualization>
              <roles>
                <role description="" specification="">Chatbot</role>
              </roles>
              <readRoles />
