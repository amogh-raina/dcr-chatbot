          <event id="FAQ_Answer_8">
            <precondition message="" />
            <custom>
              <visualization>
                <location xLoc="1100" yLoc="1070" />
                <colors bg="#f9f7ed" textStroke="#000000" stroke="#cccccc" />
              </visualization>
              <roles>
                <role description="" specification="">Chatbot</role>
              </roles>
              <readRoles />
              <groups>
                <group />
              </groups>
              <phases>
                <phase />
              </phases>
              <eventType />
              <eventScope>private</eventScope>
              <eventTypeData />
              <eventDescription>&lt;p&gt;No. Meeting the minimum documentation requirement allows the agency to assess the application; it does not establish entitlement. The agency assesses the relevant eligibility requirements and your individual circumstances, and may request more evidence.&lt;/p&gt;</eventDescription>
              <purpose>Sources: SU-Handicap-report.md, documentation requirements and pitfalls; www.su.dk_handicaptillaeg_om-dokumentation.md; www.su.dk_handicaptillaeg_spoergsmaal-og-svar-om-handicaptillaeg.md. Guideline-based answer enriched with FAQ information.</purpose>
              <guide />
