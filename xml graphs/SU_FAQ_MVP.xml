          <event id="FAQ_Answer_6">
            <precondition message="" />
            <custom>
              <visualization>
                <location xLoc="1100" yLoc="730" />
                <colors bg="#f9f7ed" textStroke="#000000" stroke="#cccccc" />
              </visualization>
              <roles>
                <role description="" specification="">Chatbot</role>
              </roles>
              <readRoles />
              <groups>
                <group />
              </groups>
              <phases>
                <phase />
              </phases>
              <eventType />
              <eventScope>private</eventScope>
              <eventTypeData />
              <eventDescription>&lt;p&gt;A note that only confirms a diagnosis, or a medication list on its own, is not enough. Include medical records explaining the symptoms, treatment history and effects on your functioning. For applications submitted from 1 July 2025, missing the minimum documentation can lead to rejection without assessment of entitlement.&lt;/p&gt;</eventDescription>
              <purpose>Sources: SU-Handicap-report.md, documentation requirements and pitfalls; www.su.dk_handicaptillaeg_om-dokumentation.md; www.su.dk_handicaptillaeg_spoergsmaal-og-svar-om-handicaptillaeg.md. Guideline-based answer enriched with FAQ information.</purpose>
              <guide />
              <insight use="false" />
              <level>100</level>
              <sequence>12</sequence>
              <costs>0</costs>
              <eventData>
                <styles />
                <dataType format="int" sequence="0" width="large">label</dataType>
              </eventData>
              <interfaces />
            </custom>
          </event>
          <event id="FAQ_Answer_7">
            <precondition message="" />
            <custom>
              <visualization>
                <location xLoc="1100" yLoc="900" />
                <colors bg="#f9f7ed" textStroke="#000000" stroke="#cccccc" />
              </visualization>
              <roles>
                <role description="" specification="">Chatbot</role>
              </roles>
              <readRoles />
              <groups>
                <group />
              </groups>
              <phases>
                <phase />
              </phases>
              <eventType />
              <eventScope>private</eventScope>
              <eventTypeData />
              <eventDescription>&lt;p&gt;No. Your personal statement supplements the medical records. It can explain your everyday difficulties, ability to have a student job, previous work, adjustments and support. It helps put the medical evidence in context but does not replace it.&lt;/p&gt;</eventDescription>
              <purpose>Sources: SU-Handicap-report.md, documentation requirements and pitfalls; www.su.dk_handicaptillaeg_om-dokumentation.md; www.su.dk_handicaptillaeg_spoergsmaal-og-svar-om-handicaptillaeg.md. Guideline-based answer enriched with FAQ information.</purpose>
              <guide />
              <insight use="false" />
              <level>100</level>
              <sequence>13</sequence>
              <costs>0</costs>
              <eventData>
                <styles />
