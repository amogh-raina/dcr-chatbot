# Copy to .env in the repo root (next to app.py) and fill in the values. Never commit .env.
# Quotes are optional: python-dotenv strips "..." or '...' around a value. Use quotes only when a value contains
# spaces or a #. Do not put spaces around "=".

# --- DCR (read by app.py; both header values are sent on every DCR call) ---
# Base URL of the DCR REST API. Must end with "/": the code appends "api/graphs/<id>".
ROOT_URL=https://repository.dcrgraphs.net/
# Sent as X-DCR-AuthToken
API_KEY=
# Sent as "Authorization: Bearer <TOKEN>" (leave empty if you only use the API key)
TOKEN=

# --- OpenAI (triage, rewrite, relevance check, answer interpretation) ---
OPENAI_API_KEY=
# 1 = use the Decisions API for triage, panel signals, contextual rewrite and the relevance check
DECISIONS_ENABLED=1
# DECISIONS_MODEL=gpt-6-luna
# DECISIONS_TIMEOUT_SECONDS=10
# DECISIONS_CONTEXT_MIN=0.7
# DECISIONS_DISTRESS_MIN=0.7
# DECISIONS_RELEVANT_MIN=0.5

# --- Phase 1, stop wrong answers (docs/specs/01-stop-wrong-answers.md) ---
# The defaults apply the change. Set the opposite value and restart `python app.py` to roll one part back.
# 1 = a list of FAQs that the relevance check prunes to one is confirmed ("Is this what you are asking?"), not answered
# CONFIRM_LONE_SURVIVOR=1
# 1 = the relevance check gives two judgements ("answers it", "same topic only"); 0 = the single check of before
# RELEVANCE_TIERS=1
# 1 = the help panel also searches a rewrite after a failed typed search (the old last resort); 0 = it does not
# PANEL_FALLBACK_REWRITE=0
# Probabilities (Decisions API) at which a FAQ counts as "answers it" and as "same topic only". Starting points, not calibrated.
# DECISIONS_ANSWERS_MIN=0.5
# DECISIONS_TOPIC_MIN=0.5

# --- Phase 3, graph split and outcome table (docs/specs/03-graph-split-outcome-table-dmn.md) ---
# Who decides the outcome of a question turn (confirm, answer, offer, clarify, not covered, out of scope, handover):
# code = the function in dcrai/chat/outcome.py, written into DCR through TurnOutcome (the default and the rollback);
# shadow = code decides, the DMN in DCR is run as well and a difference is logged (outcome_mismatch);
# dcr = the DMN in DCR decides. Needs the graph built with --outcome dmn and imported; `dcr` only after the Portal checklist (spec 7.2).
# OUTCOME_MODE=code
# panel = follow-up determinations are asked in the application help panel only; chat = the chat asks them too (before this change)
# FOLLOWUP_SURFACE=panel
# 1 = the help panel triages an unscoped typed message (a question, or out of scope); 0 = it always searches (FAQ_Triage = 1)
# PANEL_TRIAGE=1

# --- FAQ search (read by both app.py and faq_search/api.py) ---
# OpenAI model for the Responses-based fallbacks (NOT the embedding model)
# FAQ_MATCH_MODEL=gpt-4.1-mini-2025-04-14
FAQ_SINGLE_THRESHOLD=0.80
FAQ_MIN_THRESHOLD=0.50
FAQ_MARGIN_THRESHOLD=0.12
FAQ_MAX_CANDIDATES=3
# FAQ_MATCH_TIMEOUT_SECONDS=15
USE_LOCAL_RETRIEVER=1

# --- FAQ API (python -m faq_search.api) ---
# Must be the same value as header#X-API-Key on FAQ_Retrieve in the DCR Portal (where it IS written in quotes).
# New key: python -c 'import secrets; print(secrets.token_urlsafe(32))'
FAQ_API_KEY=
# FAQ_API_PORT=8090
# FAQ_QUERY_PROMPT=

# --- Logging ---
# INTERACTION_LOG=1
# INTERACTION_LOG_DIR=traces/interactions
# RUNTIME_TRACE_DIR=traces/runtime

# --- Registry (dcrai/registry.py lists every setting with type, default and class) ---
# The registry version id covers prompts, thresholds, flags, models, retrieval settings and the FAQ data digests;
# it is written on every interaction start and in traces/registry/<version>.json.
# DECISIONS_TRIAGE_MIN=0.6
# DECISIONS_REPLY_MIN=0.6
# DECISIONS_FOLLOWUP_MIN=0.7
# 1 = prefix every Decisions question with prompts/base/decisions.txt. Changes model input: leave 0 until an eval run.
# BASE_LAYER_DECISIONS=0
# 1 = the help panel keeps its context in the Panel_Context event of the graph (needs the re-imported graph)
# PANEL_CONTEXT_IN_DCR=1
# Diagnostic switch, read once at import
# APPLICATION_ENABLED_FALLBACK=0
