# Add these settings to your existing .env. Do not commit your real API key.
API_KEY=
TOKEN=
ROOT_URL=https://repository.dcrgraphs.net/
# Both api_key above and token are used for authentication with the DCR Graphs repository. and both are the same.
OPENAI_API_KEY=
FAQ_MATCH_MODEL=gpt-5-nano-2025-08-07
FAQ_SINGLE_THRESHOLD=0.80
FAQ_MIN_THRESHOLD=0.50
FAQ_MARGIN_THRESHOLD=0.12
FAQ_MAX_CANDIDATES=3
FAQ_MATCH_TIMEOUT_SECONDS=15
